{
  "_comment": "全文檢索的查詢詞擴充：問題含 when 內任一詞（不分大小寫；中文為子字串、英文為完整單字）時，全文檢索另外加上 add 的詞。用於中文問法與英文文件用詞、全名與縮寫對不上的情況（向量檢索的中文模型也補不到）。只影響查詢，不改索引，改這份檔案不需重新匯入。每一條都須能在匯出包原文找到對應用法。",
  "expansions": [
    {"when": ["強制", "必須", "必要"], "add": ["mandatory", "required"]},
    {"when": ["回覆", "回應"], "add": ["responded", "responses"]},
    {"when": ["調查", "問卷"], "add": ["survey"]},
    {"when": ["公司", "廠商"], "add": ["companies"]},
    {"when": ["期間"], "add": ["period"]},
    {"when": ["最早"], "add": ["earliest"]},
    {"when": ["設備"], "add": ["devices"]}
  ]
}
