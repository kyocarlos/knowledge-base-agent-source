# Separate service credentials only. Never use human km-dev OIDC secrets.
KM_CSIT_ENABLED=false
KM_CSIT_DB_URL=
KM_CSIT_CSIT_BASE_URL=
KM_CSIT_AUTHORITY=
KM_CSIT_AUDIENCE=
KM_CSIT_JWKS_URI=
KM_CSIT_TOKEN_URL=
KM_CSIT_CLIENT_ID=
KM_CSIT_SECRET_FILE=
KM_CSIT_SERVICE_CLIENTS=
# Must be agreed with Shared Identity's ACCESS TOKEN contract.
KM_CSIT_SERVICE_CLAIM=gty
KM_CSIT_SERVICE_CLAIM_VALUE=client_credentials
KM_CSIT_CLIENT_CLAIM=client_id
KM_CSIT_ALGORITHM=RS256
KM_CSIT_TIMEOUT=30
KM_CSIT_MAX_FILE_SIZE=52428800
KM_CSIT_LEASE_SECONDS=120
KM_CSIT_POLL_SECONDS=2
KM_CSIT_WORKER_CONCURRENCY=1
KM_CSIT_RETRY_DELAYS=10,60,300
KM_CSIT_CALLBACK_RETRY_DELAYS=10,60,300,900
KM_CSIT_STORAGE_ROOT=
KM_CSIT_CHUNK_SIZE=1200
KM_CSIT_ZIP_MAX_EXPANDED=209715200
KM_CSIT_ZIP_MAX_RATIO=100
KM_CSIT_ZIP_MAX_MEMBERS=10000
KM_CSIT_NUMERIC_RULES_FILE=
KM_CSIT_QDRANT_COLLECTION=
KM_CSIT_NEO4J_URI=
KM_CSIT_NEO4J_USER=
KM_CSIT_NEO4J_SECRET_FILE=
KM_CSIT_NEO4J_DATABASE=
KM_CSIT_TIMESCALE_DSN_FILE=
KM_CSIT_MAX_TABLE_CELLS=1000000
KM_CSIT_MAX_TEXT_CHARS=10000000

# Search-visibility policy written to every indexed chunk / km_test row. Values must follow the CSIT access settings (decision 2026-10-22);
# the defaults below are placeholders until CSIT provides its roles/departments (CSIT only names CsitStaff / Admin; no KM role mapping yet).
KM_CSIT_INDEX_ACCESS_ROLES=CSIT_ENGINEER,CSIT_MANAGER
KM_CSIT_INDEX_ACCESS_DEPARTMENTS=CSIT
KM_CSIT_INDEX_VISIBILITY=internal
KM_CSIT_INDEX_DOCUMENT_TYPE=TestReport
# Typed route for known test report workbooks (off until km_test / graph constraints / ai_km_knowledge_v1 are provisioned).
KM_CSIT_REPORT_ROUTE_ENABLED=false
# Decision 2026-10-22: reports with formula-error cells (#REF!) are accepted and flagged (quality_status=source_errors_accepted); set true when enabling the route.
KM_CSIT_REPORT_ACCEPT_SOURCE_ERRORS=true
