# CSIT document library x KM v1 (names only; real values live in the protected runtime env file, never in git).
# Shared with the Test Report integration (KM_CSIT_*): DB_URL, CSIT_BASE_URL, AUTHORITY, AUDIENCE, OUTBOUND_AUDIENCE, JWKS_URI, TOKEN_URL, CLIENT_ID, SECRET_FILE,
# SERVICE_CLIENTS, STORAGE_ROOT, MAX_FILE_SIZE, RETRY_DELAYS, CALLBACK_RETRY_DELAYS ...
KM_CSIT_DOCLIB_ENABLED=false
# Inbound route and the scope the CSIT service token must carry (CSIT-side naming may differ: adapt here, not in code).
KM_CSIT_DOCLIB_ROUTE=/api/integrations/csit/v1/document-library/jobs
KM_CSIT_DOCLIB_SUBMIT_SCOPE=km.ingestion.submit
# Outbound CSIT paths, appended to KM_CSIT_CSIT_BASE_URL. A notification's downloadUrl must equal base + download_path_template (no other host/file is fetched).
KM_CSIT_DOCLIB_DOWNLOAD_PATH_TEMPLATE=/api/integrations/km/v1/document-library/files/{documentFileId}/content
KM_CSIT_DOCLIB_STATUS_PATH=/api/integrations/km/v1/document-library/ingestion-status
# Qdrant collection for indexed library files and the access policy written to every chunk (ASSUMED until the CSIT/KM ACL decision is confirmed).
KM_CSIT_DOCLIB_COLLECTION=
KM_CSIT_DOCLIB_ACCESS_ROLES=CSIT_ENGINEER,CSIT_MANAGER
KM_CSIT_DOCLIB_ACCESS_DEPARTMENTS=CSIT
# Optional: vocabulary file (default config/csit-doclib-vocabulary.json) and LLM-assisted metadata/summary (off: summary stays null).
KM_CSIT_DOCLIB_VOCABULARY_FILE=
KM_CSIT_DOCLIB_LLM_ENABLED=false
KM_CSIT_DOCLIB_LLM_MAX_CHARS=12000
KM_CSIT_DOCLIB_PROCESSING_TIMEOUT_SECONDS=1800
