KM_A2A_ENABLED=false
KM_A2A_TRANSPORT=mock
KM_A2A_PROTOCOL_VERSION=1.0
KM_A2A_ALLOW_INSECURE_HTTP_POC=false
KM_A2A_CONTROL_TOKEN_SHA256=
KM_A2A_ALLOWED_PROFILES={"anritsu":["ncq2200b2v-throughput-v1"],"amarisoft":[]}
KM_A2A_ALLOWED_TEST_CASES={"ncq2200b2v-throughput-v1":["sa_dl_tcp","sa_ul_tcp"]}
KM_A2A_AGENT_ENDPOINTS={"anritsu":"https://anritsu.example"}
KM_A2A_AGENT_CREDENTIAL_FILES={"anritsu":"/run/secrets/anritsu-a2a-token"}
KM_A2A_JOURNAL_PATH=/var/lib/km-a2a-bridge/tasks.sqlite3

KM_A2A_HTTP_TIMEOUT_SECONDS=60
