# PostgreSQL password is required by docker-compose.yml.
KB_REPORT_DB_PASSWORD='replace-with-a-long-random-password'

# Store SHA-256 hashes only. Generate with:
# python3 -c "import hashlib; print(hashlib.sha256(b'your-token').hexdigest())"
KB_AGENT_TOKEN_HASHES_JSON='{"anritsu-agent-01":{"environment":"anritsu","token_sha256":"replace-sha256"},"amarisoft-agent-01":{"environment":"amarisoft","token_sha256":"replace-sha256"}}'
KB_REVIEWER_TOKEN_HASHES_JSON='{"reviewer-01":"replace-sha256"}'
