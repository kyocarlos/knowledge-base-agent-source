# Copy to config/wp01-deployment.env and keep the real file outside Git.
NEO4J_PASSWORD=replace-with-managed-secret
KB_REPORT_DB_PASSWORD=replace-with-managed-secret
TIMESCALEDB_PASSWORD=replace-with-managed-secret
KB_INGEST_REQUIRE_AGENT_AUTH=false
KB_ALLOW_LEGACY_INGEST=false
KB_AGENT_TOKEN_HASHES_JSON={}
KB_REVIEWER_TOKEN_HASHES_JSON={}
KB_CONFIG_ROOT=./config
KB_DATA_ROOT=./data
KB_UPLOAD_ROOT=./data/uploads
KB_REPORT_STAGING_ROOT_HOST=./data/report-staging
KB_MAX_CONCURRENT_PROCESSING=2
KB_PROCESSING_LOCK_TTL_SECONDS=600
KB_JOB_RESULT_TTL_SECONDS=3600
KB_JOB_SOFT_TIME_LIMIT_SECONDS=600
KB_JOB_TIME_LIMIT_SECONDS=720
KB_JOB_MAX_RETRIES=3
KB_JOB_RETRY_COUNTDOWN_SECONDS=5
