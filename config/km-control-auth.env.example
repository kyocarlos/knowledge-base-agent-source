# Remain disabled until Shared Identity registers an actual KM client.
KM_OIDC_ENABLED=false
# Required together only when enabling; do not add provisional values here.
# KM_OIDC_ISSUER=https://identity.example.com
# KM_OIDC_CLIENT_ID=
# KM_OIDC_CLIENT_SECRET=
# KM_OIDC_REDIRECT_URI=https://km-dev.example.com/oidc/callback
# KM_OIDC_LOGOUT_REDIRECT_URI=https://km-dev.example.com/auth/oidc/logout/callback
# KM_SESSION_SIGNING_KEY=
# KM_OIDC_CLAIM_MAPPING_JSON={"user_id":"sub","display_name":"name","email":"email"}
# KM_CONTROL_DB_PATH=data/km-control-auth.sqlite3
