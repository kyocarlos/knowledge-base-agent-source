# Non-secret names only. Supply values through the deployment secret manager.
# Do not copy a real URL or password into this file.
KB_TIMESERIES_DB_NAME=km_timeseries
KB_TIMESERIES_DB_USER=km_timeseries
KB_TIMESERIES_DB_PASSWORD=replace-in-secret-store
KM_PGADMIN_PORT=5050
KM_PGADMIN_EMAIL=admin@example.com
KM_PGADMIN_PASSWORD=replace-in-secret-store
# Application DML URL, migration URL, and readonly password are injected at
# deployment time.  They are deliberately absent from this example.
