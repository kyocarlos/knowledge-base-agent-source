# Copy outside the repository with mode 0600. Do not put real values in Git.
COMPOSE_PROJECT_NAME=km-control-3030
KM_CONTROL_NETWORK=km-control-private
KM_CONTROL_DB_PASSWORD=replace-with-unique-secret
KM_CONTROL_SESSION_SIGNING_KEY=replace-with-a-unique-32-character-minimum-secret
# Must be the trusted HTTPS origin actually exposed by the existing 3030 Nginx.
KM_TEST_PUBLIC_ORIGIN=https://km-dev-da40.duckdns.org:3030
# Supplied to the existing Test web service through its protected deployment env.
KM_INSTANCE_ID=test
KM_REDIS_KEY_PREFIX=km:test:
KM_ENTRY_SESSION_SIGNING_KEY=replace-with-a-unique-32-character-minimum-secret
KM_CONTROL_DB_URL=postgresql://km_control_app:replace-with-control-db-password@km-control-db:5432/km_control
KM_CONTROL_PUBLIC_ORIGIN=https://km-dev-da40.duckdns.org:3030
# The 3030 Nginx gateway is the only TLS terminator. It mounts this directory
# read-only; Control DB/Auth receives no certificate or private key mount.
KM_SHARED_TLS_CERT_DIR=/home/da40_ai_gb10/nginx_certs
# OIDC remains disabled until a trusted DEV FQDN, registered client ID and
# provider metadata are supplied. Do not point these values at the 3030 IP.
KM_OIDC_ENABLED=false
KM_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
KM_OIDC_ISSUER=https://shared-identity.example.invalid
KM_OIDC_AUTHORIZATION_ENDPOINT=https://shared-identity.example.invalid/authorize
KM_OIDC_TOKEN_ENDPOINT=https://shared-identity.example.invalid/token
KM_OIDC_JWKS_URI=https://shared-identity.example.invalid/jwks
KM_OIDC_CLIENT_ID=assigned-by-shared-identity
KM_OIDC_ID_TOKEN_ALGORITHMS=RS256
KM_OIDC_REDIRECT_URI=https://km-dev-da40.duckdns.org:3030/oidc/callback
KM_OIDC_POST_LOGOUT_REDIRECT_URI=https://km-dev-da40.duckdns.org:3030/oidc/logout/callback
KM_OIDC_CLIENT_SECRET=replace-with-secret-from-shared-identity
KM_OIDC_CLIENT_JWKS_PATH=/run/secrets/km-oidc/jwks.json
KM_OIDC_BINDING_SIGNING_KEY=replace-with-a-unique-32-character-minimum-secret
KM_OIDC_CLAIM_MAPPING_JSON={"account":"account","name":"name","email":"email","department":"department"}
