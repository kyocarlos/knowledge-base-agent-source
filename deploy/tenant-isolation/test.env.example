# Existing data is retained.  Do not use this file to replace the live Test
# stack until the baseline manifest and complete application restore drill pass.
COMPOSE_PROJECT_NAME=km-test
KM_INSTANCE_ID=test
KM_WEB_BIND_ADDRESS=127.0.0.1
KM_HTTPS_PORT=3130
KM_TLS_CERT_PATH=/protected/km-test/tls.crt
KM_TLS_KEY_PATH=/protected/km-test/tls.key
KM_REPORT_DB_NAME=kb_reports_test
KM_REPORT_DB_USER=kb_report_test
KM_TIMESCALE_DB_NAME=kb_timeseries_test
KM_TIMESCALE_DB_USER=kb_timeseries_test
KM_REPORT_DB_PASSWORD=replace-with-unique-secret
KM_TIMESCALE_DB_PASSWORD=replace-with-unique-secret
NEO4J_PASSWORD=replace-with-unique-secret
KM_SESSION_SIGNING_KEY=replace-with-a-unique-32-character-minimum-secret
KM_ENTRY_SESSION_SIGNING_KEY=replace-with-a-unique-32-character-minimum-secret
KM_CONTROL_DB_URL=postgresql://km_control_app:replace-with-control-db-password@km-control-db:5432/km_control
KM_CONTROL_PUBLIC_ORIGIN=https://km-control.example.invalid
KM_CONTROL_NETWORK=km-control-private
